<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>uPreviewShare.TestSite</RootNamespace>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="17.4.1" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.4.1" />
    <PackageReference Include="Umbraco.Cms.Persistence.Sqlite" Version="17.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\uPreviewShare\uPreviewShare.csproj" />
  </ItemGroup>

  <!-- Import the uPreviewShare targets to copy App_Plugins during build -->
  <Import Project="..\..\src\uPreviewShare\buildTransitive\uPreviewShare.targets" />

</Project>
